   <TestAction
      buildConfiguration = "Debug"
      selectedDebuggerIdentifier = "Xcode.DebuggerFoundation.Debugger.LLDB"
      selectedLauncherIdentifier = "Xcode.DebuggerFoundation.Launcher.LLDB"
      shouldUseLaunchSchemeArgsEnv = "NO">
      <!--
        ACERVO_APP_GROUP_ID supplies the App Group identifier to
        Acervo.sharedModelsDirectory. SwiftAcervo PR #34 removed
        customBaseDirectory and refuses to invent a per-process fallback
        path; tests use a dedicated bundle ID so they never write into a
        developer's real shared-models directory. Individual tests that
        need stricter isolation override this value per-test by setting
        ACERVO_APP_GROUP_ID to a unique UUID-suffixed group inside their
        body and cleaning up the resolved Group Containers directory on
        defer.
      -->
      <EnvironmentVariables>
         <EnvironmentVariable
            key = "ACERVO_APP_GROUP_ID"
            value = "group.acervo.testbundle.default"
            isEnabled = "YES">
         </EnvironmentVariable>
      </EnvironmentVariables>
      <Testables>
