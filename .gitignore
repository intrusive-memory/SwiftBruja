# Xcode
.DS_Store
*.xcodeproj
xcuserdata/
*.xcworkspace
!*.xcworkspace/contents.xcworkspacedata
/*.gcno

# Build
.build/
DerivedData/
build/

# Swift Package Manager
.swiftpm/
# Track the shared SPM scheme so its <EnvironmentVariables> (notably
# ACERVO_APP_GROUP_ID for the test bundle, required since SwiftAcervo PR #34
# removed customBaseDirectory) survive `xcodebuild`'s auto-generation.
# Everything else under .swiftpm/ stays local.
!.swiftpm/
!.swiftpm/xcode/
!.swiftpm/xcode/xcshareddata/
!.swiftpm/xcode/xcshareddata/xcschemes/
!.swiftpm/xcode/xcshareddata/xcschemes/*.xcscheme
Package.resolved

# CocoaPods
Pods/

# Carthage
Carthage/Build/

# Accidental files
*.orig
*~
*.profraw
bin/*
dist/*

# Mission artifacts (agent-local, not committed)
.mission/
.claude/worktrees/
SUPERVISOR_STATE.md

# graphify codemap: commit the portable graph artifacts, ignore machine-specific
# markers (absolute paths), the regenerable cache, and the absolute-path manifest.
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/.graphify_detect.json
graphify-out/cache/
graphify-out/manifest.json
graphify-out/.graphify_analysis.json
graphify-out/.graphify_semantic_marker
graphify-out/20*/
